rules_version = '2';

// GERADO por lib/auth/regras-dados.ts (npm run regras). Não edite à mão: mude a tabela e gere de novo.
// O servidor usa o Admin SDK (não passa por aqui); estas regras protegem o acesso direto do navegador
// (ex.: caixa de entrada do Atendimento em tempo real). Tudo que não está listado é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function membro(empresaId) {
      return get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid)).data;
    }
    function ativo(empresaId) {
      return logado()
        && exists(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid))
        && membro(empresaId).ativo == true;
    }
    function papelEm(empresaId, papeis) {
      return ativo(empresaId) && membro(empresaId).papel in papeis;
    }

    // Usuário só lê o próprio documento; escrita só pelo servidor.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Só o servidor (índices, segredos cifrados, filas, alertas).
    match /convites/{id=**} {
      allow read, write: if false;
    }
    match /whatsappNumeros/{id=**} {
      allow read, write: if false;
    }
    match /segredos/{id=**} {
      allow read, write: if false;
    }
    match /filaAtendimento/{id=**} {
      allow read, write: if false;
    }
    match /filaAtendimentoPegos/{id=**} {
      allow read, write: if false;
    }
    match /atena_alertas/{id=**} {
      allow read, write: if false;
    }
    match /ppAssinantes/{id=**} {
      allow read, write: if false;
    }

    match /empresas/{empresaId} {
      allow read: if ativo(empresaId);
      allow create, delete: if false; // criação pelo servidor (onboarding)
      allow update: if papelEm(empresaId, ['dono', 'gestor'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.plano == resource.data.plano; // plano/créditos só pelo servidor (cobrança)

      // equipe
      match /membros/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor']);
      }
      // convites pendentes
      match /convites/{id} {
        allow read: if papelEm(empresaId, ['dono', 'gestor']);
        allow write: if papelEm(empresaId, ['dono', 'gestor']);
      }
      // serviços e preços
      match /servicos/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor']);
      }
      // quem atende
      match /profissionais/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor']);
      }
      // contatos e funil
      match /contatos/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'atendente', 'vendedor'])
          && (request.resource == null || request.resource.data.empresaId == empresaId);
      }
      // linha do tempo do contato
      match /atividades/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'atendente', 'vendedor']);
      }
      // agenda
      match /agendamentos/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'atendente', 'vendedor']);
      }
      // trava de horário (servidor)
      match /agenda_travas/{id} {
        allow read, write: if false;
      }
      // caixa de entrada em tempo real (+ mensagens)
      match /conversas/{id=**} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'atendente']);
      }
      // conexão (sem token) e treino da IA
      match /atendimento/{id} {
        allow read: if ativo(empresaId);
        allow write: if false;
      }
      // lembretes já enviados
      match /atendimento_automacoes/{id} {
        allow read, write: if false;
      }
      // controle de envio
      match /atendimento_enviados/{id} {
        allow read, write: if false;
      }
      // inscrições de web push
      match /atendimento_push/{id} {
        allow read, write: if false;
      }
      // deduplicação do webhook
      match /atendimento_recebidos/{id} {
        allow read, write: if false;
      }
      // índice telefone → contato
      match /atendimento_telefones/{id} {
        allow read, write: if false;
      }
      // reuniões: dono/gestor veem todas; vendedor vê as dele e as da biblioteca
      match /reunioes/{id=**} {
        allow read: if papelEm(empresaId, ['dono', 'gestor'])
          || (papelEm(empresaId, ['vendedor']) && (resource.data.vendedorUid == request.auth.uid || resource.data.naBiblioteca == true));
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'vendedor']);
      }
      // roteiro e configuração do Coach
      match /coach/{id} {
        allow read: if papelEm(empresaId, ['dono', 'gestor', 'vendedor']);
        allow write: if false;
      }
      // galeria do Estúdio
      match /criacoes/{id} {
        allow read: if ativo(empresaId);
        allow write: if papelEm(empresaId, ['dono', 'gestor', 'atendente', 'vendedor']);
      }
      // calendário de conteúdo
      match /pautas/{id} {
        allow read: if ativo(empresaId);
        allow write: if false;
      }
      // extrato de créditos (só o servidor mexe)
      match /creditos/{id} {
        allow read: if ativo(empresaId);
        allow write: if false;
      }
      // assinatura
      match /cobranca/{id} {
        allow read: if papelEm(empresaId, ['dono', 'gestor']);
        allow write: if false;
      }
      // pagamentos do Asaas
      match /pagamentos/{id} {
        allow read: if papelEm(empresaId, ['dono', 'gestor']);
        allow write: if false;
      }
      // custo de IA (painel interno)
      match /uso/{id} {
        allow read, write: if false;
      }
      // Qualquer outra subcoleção: negado (o servidor usa o Admin SDK).
      match /{outra}/{id=**} {
        allow read, write: if false;
      }
    }
  }
}
