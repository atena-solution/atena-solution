# Copie para .env.local e preencha. NUNCA versionar o .env.local.
SIMULAR=1
NEXT_PUBLIC_SIMULAR=1

# Firebase (cliente) — projeto atena-solution
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor) — JSON da conta de serviço em uma linha
FIREBASE_SERVICE_ACCOUNT=

# Atendimento (sessão B) — WhatsApp Cloud API, Claude e avisos
# Chave de 32 bytes em base64 para cifrar tokens: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATENA_CHAVE_CRIPTO=
# Token de verificação do webhook (você inventa; vai no painel da Meta junto com a URL /api/whatsapp/webhook)
WHATSAPP_TOKEN_VERIFICACAO=
# App Secret do app da Atena na Meta (confere a assinatura X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSAO=v23.0
ANTHROPIC_API_KEY=
# Cron da Vercel (/api/whatsapp/cron a cada 5 min)
CRON_SECRET=
# Web push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_ASSUNTO=mailto:contato@atena.solution

# Firebase Storage (áudios do Coach, imagens do Estúdio) — ex.: atena-solution.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Gemini (transcrição do Coach e do áudio do cliente no Atendimento; imagem e vídeo do Estúdio)
GEMINI_API_KEY=
# Opcionais: trocar o modelo sem mexer no código
GEMINI_MODELO_TRANSCRICAO=
GEMINI_MODELO_IMAGEM=
GEMINI_MODELO_VIDEO=

# Cobrança (sessão E) — sem ASAAS_API_KEY fica simulado
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# E-mails (verificados) da equipe Atena que veem o /admin, separados por vírgula
ATENA_ADMIN_EMAILS=
